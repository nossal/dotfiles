#!/usr/bin/env bash

source "$DOTDIR/bin/dot"

setup() {
  export MISE_INSTALL_HELP=0
  export MISE_QUIET=1

  curl -sL https://mise.run | sh && \
    "$LOCAL_BIN_DIR/mise" install && \
    mkdir -p "$DOTDIR/shell/$shell/completions" && \
    "$LOCAL_BIN_DIR/mise" completion "$shell" > "$DOTDIR/shell/$shell/completions/_mise"
}

update() {
  # Em servidores, só instala o que falta, sem subir versões.
  if [[ " ${DOT_MODULES:-} " == *" dev "* ]]; then
    mise self-update -y
    mise up
  else
    mise install
  fi
}

install "mise"
