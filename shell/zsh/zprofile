# vi: ft=zsh

export EDITOR="$(command -v nvim || command -v vi)"
_java_home=$($HOME/.local/bin/mise where java 2>/dev/null) && export JAVA_HOME=$_java_home
unset _java_home

typeset -gU path

path=(
  $HOME/.local/share/mise/shims(N)
  /usr/local{,s}bin(N)
  /opt/{homebrew,local}/{,s}bin(N)
  $HOME/.local/bin(N)
  $HOME/.dotfiles/bin(N)
  $HOME/.atuin/bin(N)
  $HOME/.cargo/bin(N)
  $path
)

