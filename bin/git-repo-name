#!/usr/bin/env bash
set -e

dir="${1:-.}"
repo_dir="$(git -C "$dir" rev-parse --show-toplevel)"

if git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null; then

  if [[ -d "$(git -C "$dir" rev-parse --git-common-dir)/worktrees" ]]; then
    # In a linked worktree → use parent dir
    basename "$(dirname "$repo_dir")"
  else
    # In main worktree or non-worktree repo
    basename "$repo_dir"
  fi
else
  echo >&2 "Not inside a Git repository"
  exit 1
fi
