#!/usr/bin/env bash
set -euo pipefail
# autoinstall: sh "$(curl -fsL https://noss.al/dot)"

DOTFILES_HOME="$HOME/.dotfiles"
LOCAL_BIN_DIR="$HOME/.local/bin"

export DOTDIR="$DOTFILES_HOME"

LINKS_FILE="$DOTFILES_HOME/links.toml"
PROFILES_FILE="$DOTFILES_HOME/profiles.toml"
DOT_PROFILE_FILE="$HOME/.config/dot/profile"
DEFAULT_MODULES="base"
DOT_WARNINGS=()

REPO="https://github.com/nossal/dotfiles"

# declare -A CONFIG=(
#   ["os_manage"]=1
#   ["shell"]="Shell configuration files"
#   ["editor"]="Editor configuration files"
# )

UI_WIDTH=10
LINKS_CREATED=0

function ui_init() {
  # Mesma linguagem visual do git-lg. Bytes UTF-8 em hex funcionam no bash 3.2 do macOS.
  C_RESET="" C_ORANGE="" C_BLUE="" C_GREEN="" C_DIM="" C_YELLOW="" C_RED="" C_SUMMARY=""
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RESET=$'\e[0m'
    C_ORANGE=$'\e[38;2;245;77;39m'
    C_BLUE=$'\e[1;38;2;0;145;218m'
    C_GREEN=$'\e[3;32m'
    C_DIM=$'\e[2;37m'
    C_YELLOW=$'\e[33m'
    C_RED=$'\e[31m'
    C_SUMMARY=$'\e[2;3m'
  fi

  # Sem tty, ou no console do Linux, não há Nerd Font.
  G_HEAD="::" G_SUMMARY="=>" G_OK="v" G_WARN="!" G_FAIL="x" G_ADD="+" G_DEL="-"
  if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] && [ "${TERM:-}" != "linux" ]; then
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
      *UTF-8*|*utf-8*|*UTF8*|*utf8*)
        G_HEAD=$'\xef\x80\x93'
        G_SUMMARY=$'\xf3\xb1\x9e\xa9'
        G_OK=$'\xef\x80\x8c'
        G_WARN=$'\xef\x81\xb1'
        G_FAIL=$'\xef\x80\x8d'
        ;;
    esac
  fi
}
ui_init

function ui_header() {
  # Uso: ui_header comando [contexto]
  printf '%s %sdot %s%s  %s\n' "$G_HEAD" "$C_DIM" "$1" "$C_RESET" "${2:-}"
}

function ui_node() {
  # Uso: ui_node título [destaque] [detalhe] [cor do detalhe] [marca] [cor da marca]
  local badge=""
  if [ -n "${2:-}" ]; then
    printf -v badge '%s%-5s%s  ' "$C_BLUE" "$2" "$C_RESET"
  fi
  printf ' %s%s%s %s%-*s%s  %s%s%s%s\n' \
    "${6:-}" "${5:- }" "$C_RESET" \
    "$C_ORANGE" "$UI_WIDTH" "$1" "$C_RESET" \
    "$badge" "${4:-$C_GREEN}" "${3:-}" "$C_RESET"
}

function ui_line() {
  printf '   %s%s%s\n' "$C_DIM" "$1" "$C_RESET"
}

function ui_item() {
  # Uso: ui_item cor glifo texto
  printf '   %s%s%s %s\n' "$1" "$2" "$C_RESET" "$3"
}

function ui_summary() {
  printf ' %s%s %s%s\n' "$C_SUMMARY" "$G_SUMMARY" "$1" "$C_RESET"
}

function has() {
  local callable="$1"
  shift

  if declare -f "$callable" >/dev/null 2>&1; then
    "$callable" "$@"
    return $?
  fi

  command -v "$callable" 1>/dev/null 2>&1
}

function install() {
  local cmd="$1"
  local name="${2:-$cmd}"
  has "$cmd" || {
    echo "Installing $name..."
    setup
  } && {
    echo "$name is already installed."
    has update && update
  }
  return 0
}

function _shell() {
  if command -v zsh &> /dev/null; then
    # [[ ! $SHELL == *"/zsh" ]] && chsh -s /bin/zsh
    echo "zsh"
  else
    echo "bash"
  fi
}
shell="$(_shell)"

function is_wsl() {
  IFS='-' read -r _ sub rest <<< "$(uname -r)"
  [ "$sub" == "microsoft" ] && echo true
}

function username() {
  if [ "$(is_wsl)" = true ]; then
    echo "$(powershell.exe '$env:UserName' | sed -e 's/\r//g')"
    return
  fi
  echo "$USER"
}

function os_name() {
  case "$(uname -o)" in
    "GNU/Linux")
      local name
      # echo "It\`s Linux, baby!"
      name="$(awk -F= '$1=="ID" { print $2 }' /etc/os-release)"
      [ "$(is_wsl)" = true ] && name="$name-wsl"

      echo "$name"
      ;;
    "Darwin")
      # echo "Is\`s a Mac, man!"
      echo "mac"
      ;;
    "Msys")
      echo "msys2"
      ;;
    *)
      # echo "I dont\`t know"
      echo ""
      ;;
  esac
}

function config_get() {
  # Get a specific key value from a TOML section
  #
  # Arguments:
  #   $1 - TOML file path
  #   $2 - Section name
  #   $3 - Key name
  #
  # Returns:
  #   The value of the key (without quotes), or empty if not found
  #
  local file="$1"
  local section="$2"
  local key="$3"

  [ ! -f "$file" ] && return 1

  awk -v section="$section" -v key="$key" '
    BEGIN { in_section = 0; found = 0 }

    # Skip comments and empty lines
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }

    # Section headers
    /^\[.*\]$/ {
      gsub(/^\[|\]$/, "")
      in_section = ($0 == section)
      next
    }

    # Key-value pairs in target section
    in_section && /=/ {
      eq_pos = index($0, "=")
      current_key = substr($0, 1, eq_pos - 1)
      value = substr($0, eq_pos + 1)

      # Clean key and value
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", current_key)
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", value)
      gsub(/^[[:space:]]*|[[:space:]]*$/, "", current_key)
      gsub(/^[[:space:]]*|[[:space:]]*$/, "", value)

      if (current_key == key) {
        print value
        found = 1
        exit
      }
    }

    END { exit (found ? 0 : 1) }
  ' "$file"
}

function config_set() {
  # Set a key-value pair in a TOML section
  # Creates the section if it doesn't exist
  # Updates the key if it exists, adds it if it doesn't
  #
  # Arguments:
  #   $1 - TOML file path
  #   $2 - Section name
  #   $3 - Key name
  #   $4 - Value
  #
  local file="$1"
  local section="$2"
  local key="$3"
  local value="$4"
  local temp_file

  # Create file if it doesn't exist
  [ ! -f "$file" ] && touch "$file"

  temp_file="$(mktemp)"

  awk -v section="$section" -v key="$key" -v value="$value" '
    BEGIN {
      in_section = 0
      section_found = 0
      key_updated = 0
      section_ended = 0
    }

    # Section headers
    /^\[.*\]$/ {
      current_section = $0
      gsub(/^\[|\]$/, "", current_section)

      if (current_section == section) {
        in_section = 1
        section_found = 1
        section_ended = 0
        print $0
      } else {
        if (in_section && !key_updated) {
          # Add key before leaving section
          printf "\"%s\" = \"%s\"\n", key, value
          key_updated = 1
        }
        in_section = 0
        section_ended = 1
        print $0
      }
      next
    }

    # Key-value pairs
    /=/ {
      if (in_section) {
        eq_pos = index($0, "=")
        current_key = substr($0, 1, eq_pos - 1)

        # Clean current key
        gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", current_key)
        gsub(/^[[:space:]]*|[[:space:]]*$/, "", current_key)

        if (current_key == key) {
          printf "\"%s\" = \"%s\"\n", key, value
          key_updated = 1
        } else {
          print $0
        }
      } else {
        print $0
      }
      next
    }

    # All other lines
    {
      if (in_section && /^[[:space:]]*$/ && !key_updated) {
        # Empty line in section, good place to add key
        printf "\"%s\" = \"%s\"\n", key, value
        key_updated = 1
        print $0
      } else {
        print $0
      }
    }

    END {
      # If section was never found, create it
      if (!section_found) {
        if (NR > 0) print ""  # Add blank line before new section
        printf "[%s]\n", section
        printf "\"%s\" = \"%s\"\n", key, value
      }
      # If section was found but key was never added
      else if (!key_updated) {
        printf "\"%s\" = \"%s\"\n", key, value
      }
    }
  ' "$file" > "$temp_file"

  mv "$temp_file" "$file"
}

function config_list_keys() {
  # List all keys in a specific TOML section
  #
  # Arguments:
  #   $1 - TOML file path
  #   $2 - Section name
  #
  local file="$1"
  local section="$2"

  [ ! -f "$file" ] && return 1

  awk -v section="$section" '
    BEGIN { in_section = 0 }

    # Skip comments and empty lines
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }

    # Section headers
    /^\[.*\]$/ {
      gsub(/^\[|\]$/, "")
      in_section = ($0 == section)
      next
    }

    # Key-value pairs in target section
    in_section && /=/ {
      eq_pos = index($0, "=")
      key = substr($0, 1, eq_pos - 1)

      # Clean key
      gsub(/^[[:space:]]*"|"[[:space:]]*$/, "", key)
      gsub(/^[[:space:]]*|[[:space:]]*$/, "", key)

      print key
    }
  ' "$file"
}

function error() {
  printf '%s%s%s %s\n' "$C_RED" "$G_FAIL" "$C_RESET" "$*" >&2
  exit 1
}

function warn() {
  DOT_WARNINGS+=("$1")
}

function print_warnings() {
  [ "${#DOT_WARNINGS[@]}" -eq 0 ] && return 0
  local message
  for message in "${DOT_WARNINGS[@]}"; do
    UI_WIDTH=0 ui_node "$message" "" "" "" "$G_WARN" "$C_YELLOW"
  done
  DOT_WARNINGS=()
}

function in_list() {
  [[ " $2 " == *" $1 "* ]]
}

function config_list_sections() {
  awk '/^\[.*\]$/ { gsub(/^\[|\]$/, ""); print }' "$1"
}

function current_profile() {
  [ -s "$DOT_PROFILE_FILE" ] && tr -d '[:space:]' < "$DOT_PROFILE_FILE" || true
}

function modules_for() {
  local modules
  modules="$(config_get "$PROFILES_FILE" profiles "$1" || true)"
  [ -n "$modules" ] || error "Perfil desconhecido: $1 (veja: dot profiles)"
  echo "$modules"
}

function active_modules() {
  local name
  name="$(current_profile)"
  if [ -z "$name" ]; then
    echo "$DEFAULT_MODULES"
    return 0
  fi
  modules_for "$name"
}

function link_entry() {
  # Cria um link sem nunca sobrescrever arquivo real ou credencial já descriptografada.
  local source_path="$1"
  local target_path="$2"
  local target="$HOME/$target_path"
  local link_source="$DOTFILES_HOME/$source_path"

  # Link válido não muda. Link quebrado é refeito, por exemplo após apagar um .dec.
  if [ -L "$target" ] && [ -e "$target" ]; then
    return 0
  fi
  if [ ! -L "$target" ] && [ -e "$target" ]; then
    warn "mantido, já existe um arquivo real: ~/$target_path"
    return 0
  fi

  if [[ "$source_path" == *.gpg ]]; then
    local decrypted="${link_source%.gpg}.dec"
    if [ ! -e "$decrypted" ]; then
      if ! has gpg; then
        warn "gpg ausente, link ignorado: ~/$target_path"
        return 0
      fi
      ui_line "decrypting $source_path"
      if ! (umask 077; gpg --batch --yes --quiet --output "$decrypted" --decrypt "$link_source" < /dev/null) 2>/dev/null; then
        rm -f "$decrypted"
        warn "não foi possível descriptografar: $source_path"
        return 0
      fi
    fi
    link_source="$decrypted"
  fi

  if [ ! -e "$link_source" ]; then
    warn "origem não encontrada: $source_path"
    return 0
  fi

  mkdir -p "$(dirname "$target")"
  ln -sfn "$link_source" "$target"
  LINKS_CREATED=$((LINKS_CREATED + 1))
  ui_item "$C_GREEN" "$G_ADD" "~/$target_path"
}

function symlink_configs() {
  # Cria os links das seções (módulos) de links.toml recebidas como argumentos.
  local section source_path target_path total links_total=0
  LINKS_CREATED=0
  ui_header "links"

  for section in "$@"; do
    total="$(config_list_keys "$LINKS_FILE" "$section" | wc -l | tr -d ' ' || true)"
    [ "${total:-0}" -eq 0 ] && continue
    links_total=$((links_total + total))
    ui_node "$section" "$total" "links" "$C_DIM"
    while IFS= read -r source_path; do
      [ -z "$source_path" ] && continue
      target_path="$(config_get "$LINKS_FILE" "$section" "$source_path" || true)"
      [ -z "$target_path" ] && continue
      link_entry "$source_path" "$target_path"
    done < <(config_list_keys "$LINKS_FILE" "$section")
  done

  print_warnings
  ui_summary "$links_total links, $LINKS_CREATED criado(s)"
}

function apply_links() {
  local modules
  if [ -n "${1:-}" ]; then
    modules="$(modules_for "$1")"
  else
    modules="$(active_modules)"
  fi
  # shellcheck disable=SC2086
  symlink_configs $modules "$shell"
}

function prune_links() {
  # Remove links de módulos fora do perfil, apenas se apontarem para os dotfiles.
  local modules="$1"
  local section source_path target_path target link

  while IFS= read -r section; do
    in_list "$section" "$modules zsh bash" && continue
    while IFS= read -r source_path; do
      [ -z "$source_path" ] && continue
      target_path="$(config_get "$LINKS_FILE" "$section" "$source_path" || true)"
      [ -z "$target_path" ] && continue
      target="$HOME/$target_path"
      [ -L "$target" ] || continue
      link="$(readlink "$target")"
      [[ "$link" == "$DOTFILES_HOME/"* ]] || continue
      rm "$target"
      UI_WIDTH=0 ui_node "~/$target_path" "" "$section" "$C_DIM" "$G_DEL" "$C_RED"
      if [[ "$link" == *.dec ]]; then
        warn "credencial em texto puro mantida, apague se não for usar: $link"
      fi
    done < <(config_list_keys "$LINKS_FILE" "$section")
  done < <(config_list_sections "$LINKS_FILE")
}

function dot_init() {
  local name="$1"
  local modules previous
  modules="$(modules_for "$name")"
  previous="$(current_profile)"

  mkdir -p "$(dirname "$DOT_PROFILE_FILE")"
  printf '%s\n' "$name" > "$DOT_PROFILE_FILE"
  ui_header "init" "$C_BLUE$name$C_RESET  $C_DIM$modules$C_RESET"

  prune_links "$modules"
  apply_links

  if [ -n "$previous" ] && [ "$previous" != "$name" ]; then
    ui_summary "para desinstalar ferramentas que saíram do perfil: dot prune"
  fi
}

function repo_summary() {
  local sha branch when dirty
  sha="$(git -C "$DOTFILES_HOME" rev-parse --short HEAD 2>/dev/null)" || return 0
  branch="$(git -C "$DOTFILES_HOME" branch --show-current 2>/dev/null || true)"
  when="$(git -C "$DOTFILES_HOME" log -1 --format=%ar 2>/dev/null || true)"
  dirty="$(git -C "$DOTFILES_HOME" status --porcelain 2>/dev/null | wc -l | tr -d ' ' || true)"

  printf '%s%s%s %s%s%s %s%s%s' \
    "$C_GREEN" "${branch:-detached}" "$C_RESET" \
    "$C_ORANGE" "$sha" "$C_RESET" \
    "$C_DIM" "$when" "$C_RESET"
  if [ "${dirty:-0}" -gt 0 ]; then
    printf '  %s%s alterado(s)%s' "$C_YELLOW" "$dirty" "$C_RESET"
  fi
}

function dot_status() {
  local name modules section source_path target_path target total linked real stale
  local issue summary sum_total=0 sum_linked=0
  local -a issues
  name="$(current_profile)"
  modules="$(active_modules)"

  ui_header "status" "$C_BLUE${name:-nenhum}$C_RESET  $(repo_summary)"

  for section in $modules "$shell"; do
    total=0 linked=0 real=0
    issues=()
    while IFS= read -r source_path; do
      [ -z "$source_path" ] && continue
      target_path="$(config_get "$LINKS_FILE" "$section" "$source_path" || true)"
      target="$HOME/$target_path"
      total=$((total + 1))
      if [ -L "$target" ] && [ -e "$target" ]; then
        linked=$((linked + 1))
      elif [ -e "$target" ]; then
        real=$((real + 1))
        issues+=("$G_WARN|~/$target_path (arquivo real)")
      else
        issues+=("$G_FAIL|~/$target_path (ausente)")
      fi
    done < <(config_list_keys "$LINKS_FILE" "$section")
    [ "$total" -eq 0 ] && continue

    sum_total=$((sum_total + total))
    sum_linked=$((sum_linked + linked))
    if [ "$linked" -eq "$total" ]; then
      ui_node "$section" "$linked/$total" "" "" "$G_OK" "$C_GREEN"
    else
      ui_node "$section" "$linked/$total" "$((total - linked)) pendente(s)" "$C_YELLOW" "$G_WARN" "$C_YELLOW"
    fi
    for issue in ${issues[@]+"${issues[@]}"}; do
      if [ "${issue%%|*}" = "$G_FAIL" ]; then
        ui_item "$C_RED" "$G_FAIL" "${issue#*|}"
      else
        ui_item "$C_YELLOW" "$G_WARN" "${issue#*|}"
      fi
    done
  done

  stale=0
  while IFS= read -r section; do
    in_list "$section" "$modules zsh bash" && continue
    while IFS= read -r source_path; do
      [ -z "$source_path" ] && continue
      target_path="$(config_get "$LINKS_FILE" "$section" "$source_path" || true)"
      target="$HOME/$target_path"
      if [ -L "$target" ] && [[ "$(readlink "$target")" == "$DOTFILES_HOME/"* ]]; then
        stale=$((stale + 1))
        UI_WIDTH=0 ui_node "~/$target_path" "" "fora do perfil ($section)" "$C_YELLOW" "$G_WARN" "$C_YELLOW"
      fi
    done < <(config_list_keys "$LINKS_FILE" "$section")
  done < <(config_list_sections "$LINKS_FILE")
  summary="$(wc -w <<< "$modules" | tr -d ' ') módulos, $sum_linked/$sum_total links"
  if [ "$stale" -gt 0 ]; then
    summary="$summary, $stale fora do perfil (rode: dot init ${name:-<perfil>})"
  fi
  ui_summary "$summary"
}

function dot_profiles() {
  local key active mark count=0
  active="$(current_profile)"
  ui_header "profiles"
  while IFS= read -r key; do
    mark=" "
    [ "$key" = "$active" ] && mark="$G_OK"
    count=$((count + 1))
    UI_WIDTH=18 ui_node "$key" "" "$(modules_for "$key")" "$C_DIM" "$mark" "$C_GREEN"
  done < <(config_list_keys "$PROFILES_FILE" profiles)
  ui_summary "$count perfis, ativo: ${active:-nenhum}"
}

function dot_prune() {
  has mise || error "mise não encontrado"
  ui_header "prune"
  mise ls --prunable
  mise prune --tools
}

function clean() {
  ui_header "fix"
  # Find and remove broken symbolic links in the home directory (max depth 2)
  local broken_links broken_link
  broken_links=$(find "$HOME" -maxdepth 2 -type l ! -exec test -e {} \; -print 2> /dev/null || true)
  if [ -n "$broken_links" ]; then
    while IFS= read -r broken_link; do
      UI_WIDTH=0 ui_node "${broken_link/#$HOME/\~}" "" "" "" "$G_DEL" "$C_RED"
    done <<< "$broken_links"
    echo "$broken_links" | xargs rm
    ui_summary "$(wc -l <<< "$broken_links" | tr -d ' ') link(s) quebrado(s) removido(s)"
  else
    ui_summary "nenhum link quebrado"
  fi
}

# source "$DOTFILES_HOME/bin/dot-log"

function tools() {
  # Executa os scripts `setup` dos módulos ativos, conforme [setup] em profiles.toml.
  # A falha de um setup vira aviso e não interrompe os demais.
  local modules module names name setup_path
  modules="$(active_modules)"
  export DOT_MODULES="$modules"
  ui_header "tools"

  for module in $modules; do
    names="$(config_get "$PROFILES_FILE" setup "$module" || true)"
    for name in $names; do
      setup_path="$DOTFILES_HOME/$name/setup"
      [ -f "$setup_path" ] || continue
      ui_node "$name" "$module" "setup" "$C_DIM"
      [ ! -x "$setup_path" ] && chmod u+x "$setup_path"

      if "$setup_path"; then
        ui_item "$C_GREEN" "$G_OK" "concluído"
      else
        ui_item "$C_RED" "$G_FAIL" "falhou"
        warn "setup falhou: $name"
      fi
    done
  done
  print_warnings
}

function dot_update() {
  ui_header "update"
  cd "$DOTFILES_HOME" && git pull
  dot_install
}

function dot_install() {
  clean
  apply_links
  tools
}

function bootstrap() {
  # Bootstraps the dotfiles installation process
  #
  # This function handles the initial setup and installation of dotfiles:
  #   1. Checks if git is installed (required for cloning)
  #   2. If dotfiles exist:
  #      - Updates existing installation
  #   3. If dotfiles don't exist:
  #      - Clones the repository to $DOTFILES_HOME
  #   4. Ensures $LOCAL_BIN_DIR exists and is in PATH
  #   5. Executes OS-specific setup if available
  #   6. Runs the installation process
  #
  # Arguments:
  #   $@ - Additional arguments passed to dot_install
  #
  # Example:
  #   bootstrap personal  # Installs dotfiles with 'personal' profile
  #   bootstrap          # Installs dotfiles with default profile

  # check basic os. requirements
  if ! has git; then
    echo "git is required to bootstrap the dotfiles."
    exit 1
  fi

  # check if the dotfiles are already installed
  # if [ -d "$DOTFILES_HOME" ]; then
  #   echo "Dotfiles already installed. Updating..."
  #   dot_update
  # else
  #   git clone "$REPO" "$DOTFILES_HOME"
  # fi

  [ ! -e "$LOCAL_BIN_DIR" ] && \
    mkdir -p "$LOCAL_BIN_DIR"
  [[ ! "$PATH" == *"$LOCAL_BIN_DIR"* ]] && \
    export PATH="$LOCAL_BIN_DIR:$PATH"

  local os
  os="$(os_name)"

  # ask to manage the OS
  # read -r -p "Do you want to manage the OS ($os)? [y/N] " response
  # if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  #   os_setup="$DOTFILES_HOME/os/$os/setup
  #
  local os_setup
  os_setup="$DOTFILES_HOME/os/$os/setup"

  # Só o módulo `system` usa sudo e gerenciador de pacotes.
  if in_list system "$(active_modules)" && [ -f "$os_setup" ]; then
    "$os_setup" "$DOTFILES_HOME" "$LOCAL_BIN_DIR" || warn "setup do sistema falhou: $os"
  fi

  ui_header "bootstrap"
  dot_install
}

function usage() {
  # Displays the help message with usage instructions
  #
  # This function prints a formatted help message that includes:
  #   - Basic usage syntax
  #   - Available options
  #   - All available commands with descriptions
  #   - Examples of common use cases
  #
  cat << 'EOF'
    Usage: dot [OPTIONS] [COMMAND] [PROFILE]

    Options:
    -h, --help      Show this help message
    -r, --repo      Specify the repository URL (default: $REPO)

    Commands:
    init PROFILE    Save this machine's profile and sync its links
    status          Show the profile, modules and link state
    profiles        List available profiles
    links [PROFILE] Create links for the current (or given) profile
    tools           Run setup scripts of the active modules
    prune           Uninstall mise tools no longer in the profile
    update          Pull and reinstall using the current profile
    fix             Fix broken symbolic links

    Examples:
    dot                        # Bootstrap with the saved profile (or base)
    dot servidor-trabalho      # Save the profile and bootstrap
    dot init desktop-pessoal   # Change the profile, links only
    dot status

    For more information, visit: https://github.com/nossal/dotfiles
EOF
}

edit() {
  nvim -c "cd ~/.dotfiles | lua require('persistence').load()"
}

function main() {
  local command=""
  local profile=""
  if [[ $# -eq 0 ]]; then
    command="bootstrap"
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -r|--repo)
        REPO="$2"
        shift 2
        ;;
      -*)
        error "No option: $1"
        ;;
      *)
        if [[ -z "$command" ]]; then
          command="$1"
        elif [[ -z "$profile" ]]; then
          profile="$1"
        fi
        shift
        ;;
    esac
  done

  case "${command}" in
    up|update)
      dot_update
      ;;
    tools)
      tools
      ;;
    fix)
      clean
      ;;
    init)
      [ -n "$profile" ] || error "Uso: dot init <perfil> (veja: dot profiles)"
      dot_init "$profile"
      print_warnings
      ;;
    links)
      apply_links "$profile"
      ;;
    status)
      dot_status
      ;;
    profiles)
      dot_profiles
      ;;
    prune)
      dot_prune
      ;;
    ed|edit)
      edit
      ;;
    bootstrap)
      bootstrap
      ;;
    *)
      modules_for "$command" > /dev/null
      dot_init "$command"
      bootstrap
      ;;
  esac
}

# Only run main if script is executed directly (not sourced)
if [[ -n "${BASH_SOURCE:-}" && "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi

