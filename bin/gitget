#!/usr/bin/env bash

# gitget: find git repos under BASE_PATH and update them.
# requires fd
# Usage: gitget [OPTIONS] [BASE_PATH]
# Options:
#   -f, --fetch-only   Run 'git fetch --all --prune' instead of 'git pull --all'
#   -h, --help         Show this help

FETCH_ONLY=0
BASE_PATH="."

usage() {
  cat <<'EOF' >&2
Usage: gitget [OPTIONS] [BASE_PATH]
Find git repositories under BASE_PATH (default .) and update them.

Options:
  -f, --fetch-only   Run 'git fetch --all --prune' instead of 'git pull --all'
  -h, --help         Show this help
EOF
}

# Parse options: first non-option argument is treated as BASE_PATH
while [ "$#" -gt 0 ]; do
  case "$1" in
    -f|--fetch-only)
      FETCH_ONLY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -* )
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      BASE_PATH="$1"
      shift
      break
      ;;
  esac
done

# Choose command
if [ "$FETCH_ONLY" -eq 1 ]; then
  GIT_CMD=(git fetch --all --prune)
  ACTION="Fetching"
else
  GIT_CMD=(git pull --all)
  ACTION="Pulling"
fi

# match both .git directories and .git files (worktrees and submodules use .git files)
# find "$BASE_PATH" -maxdepth 5 -name ".git" -print0 |
fd '.git' --max-depth 5 \
    -E node_modules -E .cache -E '.git/*' "$BASE_PATH" -0 |
  while IFS= read -r -d '' gitpath; do
    repo_dir="$(dirname "$gitpath")"

    # Detect and skip bare repositories
    is_bare="$(git -C "$repo_dir" rev-parse --is-bare-repository 2>/dev/null || true)"
    if [ "$is_bare" = "true" ]; then
      echo -e "\033[33mSkipping bare repository: $repo_dir\033[0m"
      continue
    fi

    action_fmt="\033[32m"
    if [ "$FETCH_ONLY" -eq 1 ]; then
        action_fmt="\033[33m"
    fi
    echo -e "$action_fmt$ACTION:\033[0;37m $repo_dir\033[0m"
    (cd "$repo_dir" && "${GIT_CMD[@]}")
  done

