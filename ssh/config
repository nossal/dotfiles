# vi: ft=sshconfig
match exec "[[ $WORK_SSH_CONFIG ]]"
  Include ${WORK_SSH_CONFIG}  # ~/.dotfiles-work/ssh-config

Host *
  SendEnv LANG LC_*
  MACs hmac-md5,hmac-sha1
  ForwardX11 no
  ForwardAgent yes
  Compression no
  ControlMaster auto
  ControlPath ~/.ssh/control/%C
  ControlPersist 4h
  ServerAliveInterval 60

# GitHub, GitLab, Codeberg
Host *github.com *.gitlab.com *codeberg.org
  User nossal
  IdentityFile ~/.ssh/nossal

Host 192.168.* node-* *.local *.lan
  User nossal
  IdentityFile ~/.ssh/nossal
